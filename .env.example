# Mode bot
MODE=MANUAL
TRIGGER=tsukasa
BOT_NAME=Tsukasa
# Catatan: setting penting juga bisa diisi/diubah lewat chat oleh owner
# dengan !config atau !set, tanpa edit file ini dan tanpa restart.

# Zona waktu untuk pengingat (!ingatkan) dan statistik chat.
# Offset dipakai untuk mengubah jam lokal (mis. "jam 15:30") ke UTC.
BOT_TIMEZONE=Asia/Jakarta
BOT_TZ_OFFSET=7

# WhatsApp session (folder untuk auth Baileys)
# Di Pterodactyl, path relatif otomatis berada di /home/container.
SESSION_DIR=./session
# atau SESSION_PATH=./session.db

# Opsional: pairing code (tanpa scan QR). Isi nomor WhatsApp bot,
# format internasional tanpa +, contoh: 6281234567890
PAIRING_NUMBER=

# State DB (JSON)
STATE_DB=./tsukasa_state.json
# Pemetaan LID -> nomor telepon untuk chat pribadi (otomatis dibuat).
# Kosongkan untuk memakai ./data/lidmap.json.
LID_MAP_FILE=
# Override pengaturan yang diisi lewat chat (!config / !set).
# Otomatis dibuat saat pertama kali dipakai.
SETTINGS_DB=./database/settings.json

# HTTP server
# Pterodactyl otomatis memberi SERVER_PORT (allocation). Biarkan PORT
# sebagai default untuk lokal/VPS.
PORT=7860
HOST=0.0.0.0
SEND_API_KEY=
SEND_RATE_PER_MIN=10

# ffmpeg (opsional). Kosongkan untuk memakai ffmpeg-static dari npm.
FFMPEG_PATH=

# Gemini
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# ElevenLabs (opsional untuk TTS VN)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVEN_MODEL_ID=eleven_multilingual_v2
ELEVEN_OUTPUT_FORMAT=mp3_44100_192
ELEVEN_OPTIMIZE_LATENCY=0
ELEVEN_STABILITY=0.45
ELEVEN_SIMILARITY=0.9
ELEVEN_STYLE=0.5
ELEVEN_SPEAKER_BOOST=true
ELEVEN_RATE_HINT=normal

# VN
VN_MAX_WORDS=80

# Sticker reply: bot kadang membalas sticker dengan sticker dari pack.
STICKER_REPLY_ENABLED=true
# Peluang auto balas sticker (0-100).
STICKER_REPLY_CHANCE=30
# Cooldown auto sticker per chat (detik).
STICKER_REPLY_COOLDOWN_SEC=90
# Folder pack sticker. Subfolder = mood, isi file .webp.
STICKER_DIR=assets/stickers

# AI tools (Tier 2): AI boleh memilih aksi sendiri seperti mengirim sticker,
# bereaksi ke pesan, membuat gambar, membuat pengingat, atau mencari di web.
AI_TOOLS_ENABLED=true
# Maksimal aksi per balasan (1-5).
AI_TOOLS_MAX_ACTIONS=2
# Izinkan AI membuat gambar (butuh GEMINI key yang mendukung image generation).
AI_TOOLS_IMAGE=true
# Izinkan AI mencari info terbaru di web (DuckDuckGo + Wikipedia).
AI_TOOLS_SEARCH=true

# TikTok limits (MB)
TIKTOK_MAX_VIDEO_MB=50
TIKTOK_MAX_IMAGE_MB=5
TIKTOK_MAX_DOC_MB=80
TIKTOK_MAX_SLIDES=10

# Detector video baru + fitur verif ACC (Marga ECN / Nanime ID).
TIKTOK_MONITOR_ENABLED=true
# Akun TikTok yang dipantau, pisahkan dengan koma (tanpa atau dengan @).
TIKTOK_ACCOUNTS=@kang_zenith
# Keyword CN yang dicari di nickname. Huruf Unicode (𝙀𝘾𝙉) & hiasan otomatis dinormalisasi.
TIKTOK_CN_KEYWORD=ECN
# Hashtag wajib yang dicek di caption.
TIKTOK_HASHTAG=#margaecn
# Interval pengecekan video baru (menit).
TIKTOK_CHECK_MIN=3
# Opsional: JID tujuan notifikasi tambahan, mis. 120363xxx@g.us
TIKTOK_NOTIFY_JID=
# Opsional: endpoint scraper sendiri (lebih stabil dari TikWM).
# Placeholder: {username} dan {count}. Contoh:
# TIKTOK_API_URL=https://api.example.com/tiktok/user/{username}?count={count}
TIKTOK_API_URL=
TIKTOK_API_KEY=

# Jina Reader: jalur anti-WAF untuk membaca profil TikTok dari server Jina.
# Tanpa key tetap jalan (rate limit lebih kecil). Key opsional dari https://jina.ai/reader
TIKTOK_JINA_KEY=
# Default: https://r.jina.ai/ (biasanya tidak perlu diubah).
TIKTOK_JINA_BASE=https://r.jina.ai/

# ===== Logging =====
# Semua log panel memakai format: [YYYY-MM-DD HH:mm:ss] [LEVEL] [TAG] pesan
LOG_LEVEL=info
# Bug/error (level warn ke atas) disimpan ke database JSON agar bisa dicek ulang.
LOG_DB_LEVEL=warn
LOG_DB=./database/logs.json
LOG_DB_MAX=1000
# false = matikan output panel (penyimpanan database tetap berjalan).
LOG_CONSOLE=true
# true = tampilkan stack trace di panel.
LOG_STACK=false
# Log internal Baileys/pino: error | warn | info | debug.
BAILEYS_LOG=error

# Lokasi database JSON fitur verif/detector.
VERIF_DB=./database/verif.json
HISTORY_UP_DB=./database/history_up.json
UP_TODAY_DB=./database/up_today.json
SEEN_VIDEOS_DB=./database/seen_videos.json
# Daftar akun hasil /addakun & /delakun (kalau belum ada, pakai TIKTOK_ACCOUNTS).
TIKTOK_ACCOUNTS_DB=./database/accounts.json

# Auto-post info anime ke channel WhatsApp.
# PENTING: bot WAJIB menjadi admin channel agar bisa posting.
ANIME_CHANNEL_ENABLED=true
# Bisa berupa kode invite atau URL lengkap.
ANIME_CHANNEL_INVITE=0029VbC2pzO5K3zPHUeTud01
# Opsional: JID channel langsung, mis. 1234567890@newsletter.
# Jika diisi, bot tidak perlu resolve invite.
ANIME_CHANNEL_JID=
ANIME_CHANNEL_INTERVAL_MIN=180
ANIME_CHANNEL_MAX_PER_DAY=8
ANIME_CHANNEL_SOURCES=anilist,kitsu,animekita,jikan
ANIME_CHANNEL_PER_SOURCE=8
ANIME_CHANNEL_IMAGES=true
ANIME_CHANNEL_TRANSLATE=true
# Jeda sebelum post pertama setelah bot terhubung (detik).
ANIME_CHANNEL_START_DELAY_SEC=60
# Filter tahun rilis. 0 = pakai tahun berjalan. Set 1900 untuk nonaktifkan.
ANIME_CHANNEL_MIN_YEAR=0
# Riwayat dedupe: 0 = permanen (disarankan). Isi hari untuk membatasi.
ANIME_CHANNEL_DEDUPE_DAYS=0
ANIME_CHANNEL_DEDUPE_MAX=5000
# Selipkan info budaya/fakta Jejepangan setiap N post.
ANIME_CHANNEL_JAPAN_INFO=true
ANIME_CHANNEL_INFO_EVERY=3
# Selipkan berita bergambar setiap N post channel. 0 = nonaktif.
ANIME_CHANNEL_NEWS_EVERY=2
# Selipkan post cosplay setiap N post channel. 0 = nonaktif.
ANIME_CHANNEL_COSPLAY_EVERY=4

# Auto-post cosplay Instagram.
COSPLAY_ENABLED=true
# URL post Instagram (pisahkan koma).
COSPLAY_POSTS=
# RSS yang berisi tautan Instagram cosplay (pisahkan koma, opsional).
COSPLAY_RSS=

# Berita anime/manga/gacha + carousel Instagram (!news / !cosplay).
NEWS_ENABLED=true
NEWS_SOURCES=ann,animecorner,gematsu,siliconera
# RSS tambahan untuk sumber X/Twitter (pisahkan koma, opsional).
NEWS_X_RSS=
NEWS_PER_SOURCE=8
NEWS_ITEMS=2
# Prioritaskan berita gacha setiap N berita. 0 = nonaktif.
NEWS_GACHA_EVERY=2
# Cache RSS berita (menit).
NEWS_CACHE_MIN=10
# Anti-repost berita per chat (menit).
NEWS_REPOST_TTL_MIN=720

# Moderasi grup.
# JID tujuan log moderasi (kosong = owner).
MOD_LOG_JID=
MOD_WARN_LIMIT=5
MOD_MUTE_MINUTES=10

# Rate limit command berat (detik, per chat).
RATE_NEWS_SEC=15
RATE_DOWNLOAD_SEC=30
RATE_CHANNEL_SEC=30

# Unduh episode anime otomatis lewat !anime episode / !anime download.
ANIME_EP_MAX_MB=190
ANIME_EP_TIMEOUT_SEC=240
# Jumlah unduhan episode yang berjalan bersamaan.
ANIME_DL_CONCURRENCY=1

# Footer untuk semua output info (channel & !info).
INFO_FOOTER=> yuzaki tsukasa by ren

# Blue Archive / Pap
BA_LINKS_LOCAL=anime/bluearchive_links.json
BA_LINKS_URL=
PAP_LINKS_PATH=anime/pap_links.json

# Sticker watermark
STICKER_WM_TEXT=@Tsukasa
STICKER_WM_IMG=
STICKER_WM_SIZE=18
STICKER_WM_MARGIN=12
STICKER_WM_ALPHA=0.8
STICKER_WM_IMG_SCALE=128

# Peraturan / Moderation
PERATURAN_APIKEY=
PERATURAN_PROMPT=

# Persona
TSUKASA1_PROMPT=
TSUKASA2_PROMPT=
# Overlay opsional untuk mode dewasa owner-only (18+, chat pribadi).
# Kosongkan untuk memakai prompt bawaan yang sugestif, bukan eksplisit.
TSUKASA_ADULT_PROMPT=

# Hijabin
HIJABIN_API_URL=
HIJABIN_API_KEY=
HIJABIN_DEBUG=false

# Owner
OWNER_JID=
OWNER_NUMBER=
OWNER_LID=
OWNER_IDS=
OWNER_TAG=owner tercinta/sayang
OWNER_MATCH=
OWNER_DEBUG=false

# Welcome
WELCOME_ENABLED=true
WELCOME_TEXT=Halo {mentions}! Selamat datang di {group}. Baca deskripsi & patuhi aturan ya.

# ===== Auto-update GitHub -> Pterodactyl =====
# Bot mengecek commit baru di GitHub, git pull, lalu restart server lewat
# Pterodactyl Client API. Folder server HARUS clone git dari repo ini.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_CHECK_MIN=10
UPDATE_BRANCH=main
UPDATE_REMOTE=origin

# Repo GitHub (opsional untuk repo privat, isi GITHUB_TOKEN).
GITHUB_USER=
GITHUB_REPO=
GITHUB_TOKEN=

# Pterodactyl Client API (dibuat di Account Settings -> API Credentials).
# PTERO_URL contoh: https://panel.domain.com
# PTERO_SERVER_ID: 8 karakter dari URL panel /server/xxxxxxxx
PTERO_URL=
PTERO_CLIENT_KEY=
PTERO_SERVER_ID=
# api = restart lewat Client API, exit = keluar agar panel restart,
# none = tarik kode saja dan restart manual.
AUTO_UPDATE_RESTART_MODE=api

# ===== Reliability (Tier 5) =====
# Backup sesi WhatsApp otomatis. Folder backup tidak boleh berada di dalam
# SESSION_DIR. Backup lama dipangkas sesuai SESSION_BACKUP_KEEP.
SESSION_BACKUP_ENABLED=true
SESSION_BACKUP_INTERVAL_H=6
SESSION_BACKUP_DIR=backups/session
SESSION_BACKUP_KEEP=7

# Reconnect memakai backoff eksponensial sampai batas ini (detik).
RECONNECT_MAX_DELAY_SEC=60

# Jumlah unduhan media (HTTP & media WhatsApp) yang berjalan bersamaan.
DOWNLOAD_QUEUE_CONCURRENCY=2

# Notifikasi error ke owner (cooldown agar tidak spam).
HEALTH_ALERT_ENABLED=true
HEALTH_ALERT_COOLDOWN_SEC=120

# Audit command owner (JSONL, rotasi otomatis saat melewati batas byte).
# Command sensitif seperti config/geminikey disimpan tanpa argumen.
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=database/audit.log
AUDIT_LOG_MAX_BYTES=524288

