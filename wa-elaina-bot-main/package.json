{
  "name": "wa-tsukasa-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Tsukasa WhatsApp Assistant (Node.js / Baileys)",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && for f in src/*.js src/features/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "undici": "^6.21.0"
  },
  "overrides": {
    "libsignal": "npm:libsignal@6.0.0",
    "@whiskeysockets/eslint-config": "npm:@whiskeysockets/eslint-config@1.0.0"
  }
}
