{
  "name": "wa-tsukasa-bot",
  "version": "2.1.0",
  "private": true,
  "description": "Tsukasa WhatsApp Assistant (Node.js / Baileys) with Kaguya plugin bridge",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && for f in src/*.js src/features/*.js src/kaguya/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "@napi-rs/canvas": "^0.1.88",
    "@rafxzflow/multiscript": "^1.0.0",
    "@ryuu-reinzz/luna-lib": "4.2.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "awesome-phonenumber": "^7.7.0",
    "axios": "^1.13.3",
    "brat-canvas": "^1.0.26",
    "btch-downloader": "^6.0.25",
    "chalk": "^5.3.0",
    "cheerio": "1.0.0-rc.12",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^21.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "genshin-db": "^5.0.0",
    "got-scraping": "^4.1.1",
    "he": "^1.2.0",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.2",
    "mime-types": "^3.0.2",
    "moment-timezone": "^0.6.0",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "puppeteer": "^19.0.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "qs": "^6.14.1",
    "sharp": "^0.33.5",
    "tough-cookie": "^5.1.2",
    "undici": "^6.21.0",
    "yt-search": "^2.13.1"
  },
  "overrides": {
    "libsignal": "npm:libsignal@6.0.0",
    "@whiskeysockets/eslint-config": "npm:@whiskeysockets/eslint-config@1.0.0"
  }
}
